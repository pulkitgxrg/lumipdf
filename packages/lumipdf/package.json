{
  "name": "lumipdf",
  "version": "1.3.0",
  "description": "React PDF viewer built on PDF.js - virtualized pages, search, themes, Canva-style editable annotations, and in-browser OCR",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/styles/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && mkdir -p dist/styles && cp src/styles/index.css dist/styles/index.css",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pulkitgxrg/lumipdf.git",
    "directory": "packages/lumipdf"
  },
  "author": "Pulkit Garg",
  "peerDependencies": {
    "pdfjs-dist": "^4.7 || ^5 || ^6",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.10",
    "comlink": "^4.4.2",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.0",
    "@types/react-dom": "^19.0",
    "pdfjs-dist": "^4.7",
    "react": "^19.0",
    "react-dom": "^19.0",
    "tsup": "^9.0.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "react",
    "pdf",
    "pdf-viewer",
    "document-viewer",
    "doc-viewer",
    "viewer",
    "document",
    "file-viewer",
    "pdfjs",
    "pdf.js",
    "annotations",
    "highlight",
    "ocr",
    "text-recognition",
    "react-component",
    "typescript"
  ],
  "license": "MIT"
}
